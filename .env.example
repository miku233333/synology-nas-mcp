# Copy to .env. Use an existing shared folder and a DSM user's numeric UID/GID.
NAS_SHARE_PATH=/volume1/AI-Share
NAS_UID=1000
NAS_GID=1000

# Optional host-produced read-only storage status; use compose.status.yaml.
# Keep the producer code in a root-owned directory outside shared Docker project paths.
NAS_STATUS_DIR=
NAS_STATUS_MAX_AGE_SECONDS=600

# Generate locally with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional public HTTPS OAuth resource server; configure a separate OAuth provider.
# The resource URL is the full public /mcp URL and must match the JWT audience.
MCP_AUTH_MODE=private-bearer
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,nas-mcp:*
MCP_OAUTH_ISSUER_URL=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_RESOURCE_URL=
MCP_OAUTH_ALLOWED_SUBJECTS=
MCP_OAUTH_REQUIRED_SCOPE=nas.read

# Optional Cloudflare Access Managed OAuth at the public edge.
# Set MCP_AUTH_MODE=cloudflare-access; obtain audience from the Access application.
MCP_CF_ACCESS_ISSUER_URL=
MCP_CF_ACCESS_AUDIENCE=
MCP_CF_ACCESS_ALLOWED_EMAILS=
CLOUDFLARE_TUNNEL_TOKEN_FILE=

# Optional DSM tools. Set all three together; HTTPS certificate must be valid.
DSM_URL=
DSM_USERNAME=
DSM_PASSWORD=
DSM_CA_BUNDLE=

# State-changing tools are hidden unless explicitly enabled and scoped.
NAS_ENABLE_CONTAINER_ACTIONS=false
NAS_ALLOWED_CONTAINERS=
NAS_ENABLE_DOWNLOAD_ACTIONS=false
# Download Station format: shared-folder/path, for example Downloads/MCP
NAS_DOWNLOAD_DESTINATION=

NAS_MAX_FILE_BYTES=2097152
NAS_MAX_TEXT_CHARS=50000
NAS_MAX_SEARCH_ENTRIES=10000

# Optional OpenAI Secure MCP Tunnel; required only for the chatgpt profile.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
